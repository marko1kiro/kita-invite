{
  "name": "kita-invite-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dev": "npm run deploy -- dev",
    "deploy:staging": "npm run deploy -- staging",
    "worker:local:dev": "wrangler dev --local --env dev --ip 127.0.0.1 --port 8787",
    "worker:dry-run:dev": "wrangler deploy --dry-run --env dev",
    "worker:dry-run:staging": "wrangler deploy --dry-run --env staging",
    "smoke:dev-api": "node scripts/dev-api-smoke.mjs",
    "smoke:r2:local": "node scripts/r2-emulator-smoke.mjs",
    "backup:restore:local": "python3 scripts/backup-restore-smoke.py",
    "ci": "npm run typecheck && npm test && npm run build && npm run worker:dry-run:dev && npm run worker:dry-run:staging && npm run smoke:dev-api && npm run backup:restore:local && npm run smoke:r2:local"
  },
  "dependencies": {
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
